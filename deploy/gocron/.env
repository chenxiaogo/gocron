# ============================================================
# 调度平台离线部署环境变量
# 由 package.sh 在打包时按参数固定（镜像 tag / 环境 / 配置文件），
# 目标机一般无需修改；如需调整端口、数据目录可在此修改后执行 ./start.sh
# ============================================================

# 镜像（package.sh 自动写入实际 tag）
SCHEDULER_IMAGE_TAG=latest

# 应用环境：local / test / production（package.sh 自动写入）
SCHED_APP_ENV=production

# 实际使用的配置文件（相对部署目录，package.sh 自动写入）
# 后端固定读取容器内 /app/server/conf.d/config.yaml，
# compose 会把这里指定的文件挂载覆盖到该固定路径。
SCHED_CONFIG_FILE=conf.d/config.prod.yaml

# 宿主机监听端口（容器内固定 8080）
SCHEDULER_HTTP_PORT=18080

# 宿主机数据 / 日志目录（与部署目录分离，升级覆盖不丢数据）
HOST_DATA_DIR=/data/gocron/data
HOST_LOG_DIR=/data/gocron/logs

# JWT 密钥：请改成强随机串（当前后端以挂载的配置文件中的 security.jwtSecret 为准）
SCHED_SECURITY_JWTSECRET=change-me-please
